{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "mini-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3001
    },
    {
      "name": "api-design",
      "runtimeExecutable": "node",
      "runtimeArgs": ["src/index.js"],
      "port": 3002,
      "env": { "PORT": "3002", "SKIP_BOT": "true", "ALLOW_DEV_AUTH": "true" }
    },
    {
      "name": "mini-app-design",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3001,
      "env": { "NEXT_PUBLIC_API_URL": "http://localhost:3002" }
    }
  ]
}
