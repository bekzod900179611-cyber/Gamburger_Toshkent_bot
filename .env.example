# ---------- TELEGRAM BOT ----------
# @BotFather dan olingan token
BOT_TOKEN=
# Buyurtmalar tushadigan admin chat yoki guruh ID si (guruh bo'lsa -100... bilan boshlanadi)
ADMIN_CHAT_ID=
# Admin panelga kira oladigan Telegram ID lar, vergul bilan (botga /id yozib bilasiz).
# Admin guruhi (ADMIN_CHAT_ID) a'zolari ham avtomatik admin bo'ladi.
ADMIN_IDS=
# Mini App ochiladigan HTTPS manzil (Vercel / ngrok / cloudflared)
WEBAPP_URL=
# Backendning HTTPS manzili. Bo'sh bo'lsa bot polling rejimida ishlaydi (lokal uchun qulay)
WEBHOOK_URL=
# Webhook'ni himoyalovchi tasodifiy satr: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---------- MA'LUMOTLAR BAZASI (Neon PostgreSQL) ----------
DATABASE_URL=

# ---------- SERVER ----------
PORT=3000
NODE_ENV=development
# Mini App qaysi manzildan so'rov yuborishi mumkin (vergul bilan bir nechta)
CORS_ORIGINS=http://localhost:3001

# ---------- YETKAZIB BERISH ----------
DELIVERY_FEE=10000
# Shu summadan oshsa yetkazib berish bepul (0 — har doim pullik)
FREE_DELIVERY_FROM=200000

# ---------- TO'LOVLAR (Telegram Payments provayder tokenlari, @BotFather → Payments) ----------
CLICK_PROVIDER_TOKEN=
PAYME_PROVIDER_TOKEN=
# Telegram Stars: 1 yulduz necha so'm deb hisoblanadi
STARS_RATE=200

# ---------- RESTORAN ----------
RESTAURANT_NAME=Gamburger
RESTAURANT_PHONE=+998 90 123 45 67
RESTAURANT_ADDRESS=Toshkent sh., Amir Temur ko'chasi, 1

# ---------- DASTURCHI REJIMI ----------
# true bo'lsa Mini App'ni Telegramsiz oddiy brauzerda sinash mumkin. Ishlab chiqarishda false!
ALLOW_DEV_AUTH=false
DEV_TELEGRAM_ID=1
